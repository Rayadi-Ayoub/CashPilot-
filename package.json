    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "next": "^16.4.5",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.1.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2"
  }
}
