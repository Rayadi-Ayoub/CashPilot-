{
  "info": {
    "name": "CashPilot API - Invoices",
    "description": "API REST tests for CashPilot invoices (ISO 6.3 API contract, ISO 6.6 access control: 401 without session, 403 for collaborators, 404 for unknown or other-company invoices). Run with tests/api/run-newman.sh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "cashpilot-api-invoices"
  },
  "item": [
    {
      "name": "GET /api/v1/invoices - 200 + JSON structure (authenticated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "cashpilot_session={{session_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/v1/invoices",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "v1",
            "invoices"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Body is an array\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Each invoice has required fields\", function () {",
              "    const data = pm.response.json();",
              "    if (data.length > 0) {",
              "        pm.expect(data[0]).to.include.all.keys([\"id\", \"number\", \"status\", \"total\", \"remaining\", \"contact\", \"dueDate\", \"createdAt\"]);",
              "    }",
              "});",
              "",
              "pm.test(\"Response time < 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/v1/invoices - 401 not authenticated",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/api/v1/invoices",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "v1",
            "invoices"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Response is JSON with an error\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "    pm.expect(pm.response.json().error).to.equal(\"Authentication required.\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/v1/invoices/[id] - 200 detail with payments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "cashpilot_session={{session_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/v1/invoices/{{invoice_id}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "v1",
            "invoices",
            "{{invoice_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has invoice detail fields\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.include.all.keys([\"id\", \"number\", \"status\", \"total\", \"remaining\", \"contact\", \"payments\", \"dueDate\"]);",
              "    pm.expect(data.contact).to.include.all.keys([\"id\", \"name\"]);",
              "    pm.expect(data.payments).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Remaining equals total minus payments\", function () {",
              "    const data = pm.response.json();",
              "    const paid = data.payments.reduce((sum, p) => sum + p.amount, 0);",
              "    pm.expect(data.remaining).to.be.closeTo(data.total - paid, 0.01);",
              "});"
            ]
          }
        }
      ]
    },
