generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  COLLABORATOR
}

enum ContactType {
  CLIENT
  SUPPLIER
}

enum InvoiceStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  createdAt       DateTime     @default(now())
  memberships     Membership[]
  sessions        Session[]
  payments        Payment[]
  expenses        Expense[]     @relation("ExpenseSubmission")
  reviewedExpenses Expense[]    @relation("ExpenseReview")
  paidExpenses    Expense[]     @relation("ExpensePayment")
}

model Company {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  contacts    Contact[]
  invoices    Invoice[]
  payments    Payment[]
  expenses    Expense[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(COLLABORATOR)
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contact {
  id        String      @id @default(cuid())
  companyId String
  type      ContactType
  name      String
  email     String      @default("")
  phone     String      @default("")
  address   String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  expenses  Expense[]

  @@unique([companyId, type, name])
  @@index([companyId])
}

model Invoice {
  id                 String        @id @default(cuid())
  companyId          String
  contactId          String
  number             String?
  status             InvoiceStatus @default(DRAFT)
  total              Decimal
  issueDate          DateTime?
  dueDate            DateTime
  notes              String        @default("")
  validatedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact            Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  payments           Payment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([contactId])
}

model Payment {
  id           String   @id @default(cuid())
  companyId    String
  invoiceId    String
  recordedById String
  amount       Decimal
  paidAt       DateTime
  method       String
  reference    String   @default("")
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([companyId, paidAt])
  @@index([invoiceId])
}

model Expense {
  id                String        @id @default(cuid())
  companyId         String
  submittedById     String
  supplierId        String?
  reviewedById      String?
  paidById          String?
  category          String
  description       String
  amount            Decimal
  expenseDate       DateTime
  status            ExpenseStatus @default(PENDING)
  receiptName       String
  receiptStoredName String
  receiptType       String
  reviewNote        String        @default("")
  reviewedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy       User          @relation("ExpenseSubmission", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy        User?         @relation("ExpenseReview", fields: [reviewedById], references: [id], onDelete: SetNull)
  paidBy            User?         @relation("ExpensePayment", fields: [paidById], references: [id], onDelete: SetNull)
  supplier          Contact?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([submittedById])
}
